# Supabase project config (safe to expose to the browser — protected by RLS)
# Find these at: Supabase Dashboard > Project Settings > API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Google AdSense publisher id (e.g. ca-pub-1234567890123456)
# Leave empty to show ad placeholders instead of loading real ads.
PUBLIC_ADSENSE_CLIENT_ID=

# Used to build absolute URLs for sitemap.xml, robots.txt and Open Graph tags
PUBLIC_SITE_URL=http://localhost:5173
