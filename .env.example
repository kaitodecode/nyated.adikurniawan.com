# Firebase client config (safe to expose to the browser)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Set to "true" to use local Firebase emulators in development
PUBLIC_USE_FIREBASE_EMULATORS=false

# Google AdSense publisher id (e.g. ca-pub-1234567890123456)
# Leave empty to show ad placeholders instead of loading real ads.
PUBLIC_ADSENSE_CLIENT_ID=

# Used to build absolute URLs for sitemap.xml, robots.txt and Open Graph tags
PUBLIC_SITE_URL=http://localhost:5173

# Firebase Admin SDK service account (server-only, keep secret!)
# Generate at: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
