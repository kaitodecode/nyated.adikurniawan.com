rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Single-admin CMS: any signed-in Firebase Auth user is treated as admin.
    // Only create accounts for people you trust with full write access.
    function isAdmin() {
      return request.auth != null;
    }

    match /articles/{articleId} {
      allow get: if resource.data.status == 'published' || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Only written by the trusted backend (Admin SDK / Cloud Functions).
    match /dailyStats/{date} {
      allow read, write: if false;
    }
  }
}
